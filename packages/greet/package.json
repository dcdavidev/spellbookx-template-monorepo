{
  "name": "greet",
  "version": "0.0.0",
  "description": "A tiny greeting library.",
  "homepage": "https://github.com/dcdavidev/spellbookx-template-monorepo#readme",
  "bugs": {
    "url": "https://github.com/dcdavidev/spellbookx-template-monorepo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dcdavidev/spellbookx-template-monorepo.git",
    "directory": "packages/greet"
  },
  "license": "MIT",
  "author": "Davide Di Criscito <info@dcdavidev.me>",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage .turbo",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint:types": "tsc -p tsconfig.json",
    "test": "vitest run --no-fsModuleCache --passWithNoTests --coverage"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
